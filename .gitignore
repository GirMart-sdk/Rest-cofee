# Dependencies
# Ignora las carpetas de dependencias en la raíz y en los subproyectos.
/node_modules
/hostal-cofre/client/node_modules
/hostal-cofre/server/node_modules

# Build output
# Ignora las carpetas de compilación.
/dist
/build

# Environment variables
# Ignora los archivos de entorno que contienen secretos, pero incluye los de ejemplo.
.env
.env.*
!.env.example

# Logs
# Ignora archivos de log que pueden generarse.
logs
*.log
npm-debug.log*

# OS generated files
.DS_Store
Thumbs.db

# IDE directories
.vscode/
.idea/

# Prisma
# Ignora el cliente de Prisma generado, ya que se crea al instalar dependencias.
/hostal-cofre/server/node_modules/.prisma/client