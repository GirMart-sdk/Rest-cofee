{
  "name": "rest-cofee",
  "version": "1.0.0",
  "private": true,
  "description": "Hostal Cofee - Restaurant Management System",
  "scripts": {
    "dev": "npm run dev --prefix hostal-cofre/server",
    "build": "npm run build --prefix hostal-cofre/server && npm run build --prefix hostal-cofre/client",
    "lint": "npm run lint --prefix hostal-cofre/server && npm run lint --prefix hostal-cofre/client",
    "lint:fix": "npm run lint:fix --prefix hostal-cofre/server && npm run lint:fix --prefix hostal-cofre/client",
    "format": "npm run format --prefix hostal-cofre/server && npm run format --prefix hostal-cofre/client",
    "test": "npm run test --prefix hostal-cofre/server",
    "test:security": "npm run test:security --prefix hostal-cofre/server",
    "start": "npm run start --prefix hostal-cofre/server",
    "start:all": "powershell -ExecutionPolicy Bypass -File start.ps1",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "lint-staged": {
    "hostal-cofre/server/**/*.{ts,js}": "npm run lint:fix --prefix hostal-cofre/server",
    "hostal-cofre/client/**/*.{ts,tsx,js,jsx}": "npm run lint:fix --prefix hostal-cofre/client"
  }
}
