generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String         @unique
  password         String
  role             Role           @default(client)
  twoFactorSecret  String?
  twoFactorEnabled Boolean        @default(false)
  tokenVersion     Int            @default(0)
  securityQuestion String?
  securityAnswer   String?
  orders           Order[]
  reservations     Reservation[]
  shifts           Shift[]
  refreshTokens    RefreshToken[]
  loginAttempts    LoginAttempt[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, revoked])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())
  
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

enum Role {
  admin
  client
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  category    Category
  image       String?
  available   Boolean  @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

enum Category {
  ensalada
  pasta
  pizza
  postre
  bebida
}

model Order {
  id             String         @id @default(cuid())
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName   String
  customerPhone  String
  customerEmail  String?
  total          Float
  status         OrderStatus    @default(pending)
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus  @default(pending)
  paymentId      String?
  items          OrderItem[]
  
  orderType      OrderType      @default(tienda)
  tableId        String?
  table          Table?         @relation(fields: [tableId], references: [id], onDelete: SetNull)
  address        String?
  deliveryZone   DeliveryZone?
  deliveryFee    Float          @default(0)
  deliveryNotes  String?
  receiptNumber  String?
  
  shiftId        String?
  shift          Shift?         @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([tableId])
  @@index([shiftId])
  @@index([userId])
  @@index([status])
  @@index([orderType])
  @@index([createdAt])
}

enum OrderStatus {
  pending
  preparing
  ready
  out_for_delivery
  delivered
  cancelled
}

enum PaymentMethod {
  cash
  wompi
  nequi
  daviplata
}

enum PaymentStatus {
  pending
  paid
  failed
}

enum OrderType {
  domicilio
  tienda
  mesa
}

enum DeliveryZone {
  centro
  periurbano
  lejano
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  quantity   Int
  price      Float

  @@index([orderId])
  @@index([menuItemId])
}

model Table {
  id           String        @id @default(cuid())
  number       Int           @unique
  capacity     Int
  zone         Zone
  reservations Reservation[]
  orders       Order[]
}

enum Zone {
  interior
  exterior
  privado
}

model Reservation {
  id        String            @id @default(cuid())
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  phone     String
  email     String?
  date      DateTime
  time      String
  guests    Int
  tableId   String?
  table     Table?            @relation(fields: [tableId], references: [id], onDelete: SetNull)
  notes     String?
  status    ReservationStatus @default(pending)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([date])
  @@index([status])
}

enum ReservationStatus {
  pending
  confirmed
  cancelled
}

model Shift {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  cashierName  String
  shiftPeriod  ShiftPeriod
  openingCash  Float
  closingCash  Float?
  totalSales   Float     @default(0)
  totalOrders  Int       @default(0)
  cashReceived Float     @default(0)
  digitalTotal Float     @default(0)
  notes        String?
  status       ShiftStatus @default(open)
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  orders       Order[]

  @@index([status])
  @@index([openedAt])
}

enum ShiftPeriod {
  manana
  medio_dia
  tarde
  noche
}

enum ShiftStatus {
  open
  closed
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  userEmail  String
  action     String
  resource   String
  resourceId String?
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([resource, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}
