# ============================================
# HOSTAL COFEE - Server Environment Variables
# Copy this file to .env and fill in values
# ============================================

# --- Server ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/hostal_cofee?schema=public"

# --- JWT Authentication ---
# IMPORTANT: Generate a strong secret (min 32 chars). Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_MIN_32_CHARS"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- CORS ---
CORS_ORIGIN="http://localhost:5173"

# --- Wompi (Pagos) ---
# Modo: "sandbox" (default) | "production"
WOMPI_MODE="sandbox"
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
# Opcional: sobreescribe la URL base. Defaults: sandbox https://api-sandbox.wompi.su/v1 | production https://api.wompi.su/v1
WOMPI_BASE_URL=""

# --- WhatsApp ---
# Número del restaurante (wa.me deep links)
WHATSAPP_PHONE="573001234567"
# --- WhatsApp Business API (opcional, para envío server-side) ---
# Dejar vacío mantiene el comportamiento actual (deep links wa.me)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# --- Account Lockout ---
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW_MS=900000
LOCKOUT_DURATION_MS=900000

# --- Seed credentials (only used in development) ---
ADMIN_EMAIL="admin@hostalcofee.com"
ADMIN_PASSWORD="ChangeMe!2026"
CLIENT_EMAIL="cliente@mail.com"
CLIENT_PASSWORD="ChangeMe!2026"
