# ============================================
# HOSTAL COFEE - Server Environment Variables
# Copy this file to .env and fill in values
# ============================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hostal_cofee?schema=public"

# JWT Authentication
# IMPORTANT: Generate a strong secret (min 32 chars). Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_MIN_32_CHARS"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:5173"

# Wompi (Pagos)
WOMPI_PUBLIC_KEY=""
WOMPI_PRIVATE_KEY=""
WOMPI_BASE_URL="https://api-sandbox.wompi.su/v1"

# WhatsApp
WHATSAPP_PHONE="573001234567"

# Seed credentials (only used in development)
ADMIN_EMAIL="admin@hostalcofee.com"
ADMIN_PASSWORD="ChangeMe!2026"
CLIENT_EMAIL="cliente@mail.com"
CLIENT_PASSWORD="ChangeMe!2026"
