# ============================================================
# HOSTAL COFEE - Plantilla de variables de entorno para PRODUCCION
#
# Copia este archivo a hostal-cofre/server/.env y editalo.
# deploy\deploy.ps1 lo hace automaticamente si .env no existe
# y valida que JWT_SECRET sea un secreto real de mas de 32 caracteres.
# ============================================================

# --- Servidor ---
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# --- Base de datos ---
# Formato: postgresql://USUARIO:CLAVE@HOST:PUERTO/NOMBRE_BD?schema=public
DATABASE_URL="postgresql://postgres:TU_CLAVE_AQUI@localhost:5432/hostal_cofee?schema=public"

# --- JWT (autenticacion) ---
# IMPORTANTE: minimo 32 caracteres y unico para este despliegue.
# El servidor se niega a arrancar en produccion si el valor parece de plantilla.
# Genera uno seguro con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REEMPLAZA_ESTE_SECRETO_POR_UNO_REAL_DE_64_CARACTERES_HEX"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- CORS ---
# Dominio publico de la aplicacion (debe coincidir con el de Caddy).
CORS_ORIGIN="https://yourdomain.com"

# --- Wompi (pagos) ---
# Modo: "sandbox" (pruebas) | "production" (pagos reales)
WOMPI_MODE=production
WOMPI_PUBLIC_KEY="pub_prod_TU_CLAVE_PUBLICA"
WOMPI_PRIVATE_KEY="priv_TU_CLAVE_PRIVADA"
# Secreto de eventos (webhooks): en el Dashboard de Wompi (Mi cuenta -> Secretos).
# Obligatorio para validar la firma de los eventos en /api/payments/webhook.
# Apunta la URL de eventos en Wompi a: https://yourdomain.com/api/payments/webhook
WOMPI_EVENTS_SECRET="prod_events_TU_SECRETO_DE_EVENTOS"
# Opcional: sobreescribe la URL base de Wompi. Defaults: https://production.wompi.co/v1
WOMPI_BASE_URL=""

# --- WhatsApp (opcional; si se deja vacio usa deep links wa.me) ---
WHATSAPP_PHONE="573001234567"
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# --- Bloqueo de cuentas (seguridad) ---
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW_MS=900000
LOCKOUT_DURATION_MS=900000
LOCKOUT_IP_MAX_ATTEMPTS=10

# --- Push Notifications (opcional) ---
# Genera un par de claves VAPID con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# --- Credenciales del seed (solo se usan al ejecutar npm run db:seed) ---
# El seed se niega a ejecutarse si las contrasenas son de plantilla (p.ej. "CambiaEstaClaveAdmin").
ADMIN_EMAIL="admin@hostalcofee.com"
ADMIN_PASSWORD="CambiaEstaClaveAdmin"
CLIENT_EMAIL="cliente@mail.com"
CLIENT_PASSWORD="CambiaEstaClaveCliente"
